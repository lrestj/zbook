#### SWAY KEYBINDINGS ####

### Variables
    set $mod Mod4
    set $cs Ctrl+Shift
    set $ca Ctrl+Alt
    set $ma Mod4+Alt
    set $ms Mod4+Shift

### Apps & scripts
    bindsym $ms+c reload
    bindsym $mod+a exec $TERMINAL
    bindsym $mod+y exec $TERMINAL --class yazi -e yazi
    bindsym Alt+b exec $TERMINAL --class btop -e btop
    bindsym $mod+e exec $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim"
    bindsym $mod+b exec $BROWSER
    bindsym $mod+n exec $FILEMGR
    bindsym $mod+p exec mpv --player-operation-mode=pseudo-gui
    bindsym Alt+k exec pkill $KALK || $KALK
    bindsym $mod+i exec links
    bindsym $mod+m exec confm
    bindsym $mod+u exec vupdnx
    bindsym $mod+Insert exec screenshot
    bindsym $ca+W exec wallpaper

    # Show menus
    bindsym $mod+Backslash exec pkill $MENU || $MENU
    bindsym $mod+x exec pkill $MENU || powercenter

    # Toggle waybar & taskbar
    bindsym $mod+Return exec pkill waybar || waybar
    bindsym $ma+Return exec pkill waybar && waybar --config ~/.config/waybar/config-taskbar

    # Clipboard toggle
    bindsym $mod+c exec pkill fuzzel || cliphist-fuzzel-img

    # Opacity
    bindsym $cs+p opacity plus 0.05
    bindsym $cs+o opacity minus 0.05

    # Move your focus around
    bindsym $mod+q kill
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right
    bindsym $mod+Shift_L focus next

    # Move window
    bindsym $mod+h move left 10px
    bindsym $mod+k move up 10px
    bindsym $mod+j move down 10px
    bindsym $mod+l move right 10px

    # Resize window
    bindsym $ms+Left resize shrink width 10px
    bindsym $ms+Up resize grow height 10px
    bindsym $ms+Down resize shrink height 10px
    bindsym $ms+Right resize grow width 10px

    # Switch to workspace
    bindgesture swipe:down exec nextws
    bindgesture swipe:up exec prevws
    bindsym Alt+KP_1 workspace 1
    bindsym Alt+KP_2 workspace 2
    bindsym Alt+KP_3 workspace 3
    bindsym Alt+KP_4 workspace 4
    bindsym Alt+space workspace back_and_forth
    bindsym Alt+right exec nextws
    bindsym Alt+left exec prevws

    # Move focused container to workspace
    bindsym Shift+KP_1 move container to workspace 1
    bindsym Shift+KP_2 move container to workspace 2
    bindsym Shift+KP_3 move container to workspace 3
    bindsym Shift+KP_4 move container to workspace 4

    # Move and focus focused container to workspace
    bindsym $ma+KP_1 move container to workspace 1; workspace 1
    bindsym $ma+KP_2 move container to workspace 2; workspace 2
    bindsym $ma+KP_3 move container to workspace 3; workspace 3
    bindsym $ma+KP_4 move container to workspace 4; workspace 4

    # Center window and move it to corners
    bindsym $mod+KP_0 floating toggle, resize set 1300 900
    bindsym $mod+KP_7 floating enable, resize set 50ppt 50ppt, move position 0ppt 0ppt
    bindsym $mod+KP_8 floating enable, resize set 50ppt 50ppt, move position 50ppt 0
    bindsym $mod+KP_4 floating enable, resize set 50ppt 50ppt, move position 0 50ppt 
    bindsym $mod+KP_5 floating enable, resize set 50ppt 50ppt, move position 50ppt 50ppt 

    # Layout toggle & fullscreen
    bindsym $cs+w layout toggle split
    bindsym $mod+f layout toggle tabbed split
    bindsym $ma+f fullscreen

    # Toggle between tiling and floating mode
    bindsym $ms+f floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move window to the scratchpad and show
    bindsym $ma+s move scratchpad 
    bindsym $mod+s scratchpad show

    # Laptop multimedia keys for volume and LCD brightness
    bindsym XF86AudioRaiseVolume exec volumeup
    bindsym XF86AudioLowerVolume exec volumedown
    bindsym XF86AudioMute exec mute
    bindsym XF86AudioMicMute exec micmute
    bindsym XF86MonBrightnessUp exec brightnessup
    bindsym XF86MonBrightnessDown exec brightnessdown

#### END OF FILE ####
