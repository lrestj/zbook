#!/usr/bin/env sh

directory="/run/media/${USER}/"
removable="$(ls "$directory")"
lines="$(ls "$directory" | wc -l)"

[ "$lines" = "0" ] && notify-send "⚠️  Není co odpojit." && exit 1

selection="$(echo "$removable" | fuzzel --dmenu -l "$lines" -p "💾  Odpojit?")"

[ -z "$selection" ] && exit 1

udiskie-umount "${directory}/${selection}"
