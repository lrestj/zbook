#!/bin/bash

set -e

echo
echo "##################################"
echo "#  Na jaký počítač instalujete?  #"
echo "#  Zbook = 1                     #"
echo "#  Probook = 2                   #"
echo "#  Mirantb = 3                   #"
echo "##################################"

while true; do
    read -r -n 1 -p " Vyberte 1/2/3: " answer
    case $answer in
        [1]* ) echo
               echo "###########################"
               echo "#                         #"
               echo "#  Zvolili jste Zbook...  #"
               echo "#                         #"
               echo "###########################"
               echo
               sleep 4 
               break;;
        [2]* ) echo
               echo "#############################"
               echo "#                           #"
               echo "#  Zvolili jste Probook...  #"
               echo "#                           #"
               echo "#############################"
               echo
               sleep 4 
               break;;
        [3]* ) echo
               echo "#############################"
               echo "#                           #"
               echo "#  Zvolili jste Mirantb...  #"
               echo "#                           #"
               echo "#############################"
               echo
               sleep 4
               break;;
         * ) echo "Vyberte 1, 2, nebo 3";;
     esac
done

echo
echo "#######################"
echo "#  Instalace balíčků  #"
echo "#######################"
sleep 2
sudo apt install \
    btop bibata-cursor-theme curl diodon evince fastfetch fd-find \
    firewall-applet firewalld fish font-manager fonts-jetbrains-mono fzf \
    gcolor3 hplip-gui imagemagick jq kitty nfs-common  \
    papirus-icon-theme power-profiles-daemon qt6ct \
    resvg ripgrep simple-scan vainfo wget \
    make gcc libncurses5-dev libx11-dev libxt-dev libxpm-dev python3-dev \
    youtubedl-gui zoxide 
echo 
echo "#######################"
echo "#  Instalace Yazi     #"
echo "#######################"
sleep 2
curl -fsSL https://yazi-rs.github.io/builds/yazi-keyring.gpg | sudo tee /usr/share/keyrings/yazi-keyring.gpg >/dev/null
echo 'deb [signed-by=/usr/share/keyrings/yazi-keyring.gpg] https://yazi-rs.github.io/builds/ stable main' | sudo tee /etc/apt/sources.list.d/yazi.list >/dev/null
sudo apt update && sudo apt install yazi

case $answer in
    [1]* ) echo
           echo "####################################"
           echo "#                                  #"
           echo "#  Probíhá konfigurace Zbook...    #"
           echo "#                                  #"
           echo "####################################"
           git clone --bare -b cinnamon https://github.com/lrestj/zbook.git $HOME/.cfg.git
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME checkout -f &&
           bash $HOME/.local/bin/bravedeb
           echo
           echo "###################################"
           echo "#  Konfigurace git repozitáře...  #"
           echo "###################################"
           git config --global user.email "rest@seznam.cz"
           git config --global user.name "LrestJ"
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote remove origin
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote add github git@github.com:lrestj/zbook.git
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote add gitlab git@gitlab.com:lrestj/zbook.git
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote -v
           echo
           echo "################################"
           echo "#  Instalace prohlížeče Brave  #"
           echo "################################"
           bash $HOME/.local/bin/bravedeb
           ;;
    [2]* ) echo
           echo "######################################"
           echo "#                                    #"
           echo "#  Probíhá konfigurace Probook...    #"
           echo "#                                    #"
           echo "######################################"
           git clone --bare -b cinnamon https://github.com/lrestj/zbook.git $HOME/.cfg.git
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME checkout -f &&
           echo
           echo "###################################"
           echo "#  Konfigurace git repozitáře...  #"
           echo "###################################"
           git config --global user.email "rest@seznam.cz"
           git config --global user.name "LrestJ"
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote remove origin
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote add github git@github.com:lrestj/probook.git
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote add gitlab git@gitlab.com:lrestj/probook.git
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote -v
           ;;
    [3]* ) echo
           echo "######################################"
           echo "#                                    #"
           echo "#  Probíhá konfigurace Mirantb...    #"
           echo "#                                    #"
           echo "######################################"
           git clone --bare -b cinnamon https://github.com/lrestj/mirantb.git $HOME/.cfg.git
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME checkout -f &&
           echo
           echo "###################################"
           echo "#  Konfigurace git repozitáře...  #"
           echo "###################################"
           git config --global user.email "rest@seznam.cz"
           git config --global user.name "LrestJ"
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote remove origin
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote add github git@github.com:lrestj/mirantb.git
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote add gitlab git@gitlab.com:lrestj/mirantb.git
           git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME remote -v
           echo
           echo "################################"
           echo "#  Instalace prohlížeče Brave  #"
           echo "################################"
           bash $HOME/.local/bin/bravedeb
           ;;
     * ) exit 1;;
esac

git clone https://github.com/lrestj/install $HOME/.dotfiles/install/
cd $HOME/.dotfiles/install/
git config --global user.email "rest@seznam.cz"
git config --global user.name "LrestJ"
git remote remove origin
git remote add github git@github.com:lrestj/install.git
git remote add gitlab git@gitlab.com:lrestj/install.git
git remote -v

echo    
echo "#######################################"
echo "#  Envars & firewall & swappiness  #"
echo "#######################################"
cat $HOME/.dotfiles/environment | sudo tee -a /etc/environment >> /dev/null
sudo systemctl enable firewalld.service
sudo mkdir -p /etc/sysctl.d
echo vm.swappiness=10 | sudo tee /etc/sysctl.d/99-swappiness.conf
sudo cp -rv /home/libor/.dotfiles/journald.conf.d /etc/systemd/

echo
echo "###########################"
echo "#  Nfs Synology settings  #"
echo "###########################"
sudo cp -v /etc/fstab /etc/fstab.bak
cat $HOME/.dotfiles/nfs2fstab.txt | sudo tee -a /etc/fstab >> /dev/null

echo
echo "###################"
echo "#  Grub settings  #"
echo "###################"
sudo apt purge os-prober
sudo sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=2/' /etc/default/grub
sudo sed -i '11iGRUB_THEME=/home/libor/.dotfiles/TelaGrubTheme/theme.txt' /etc/default/grub
sudo cp -fv $HOME/.dotfiles/40_custom /etc/grub.d/
sudo update-grub

sudo powerprofilesctl set performance

# Nvidia install to Zbook
case $answer in
    [1]* ) bash /home/libor/.local/bin/nvdinstall
           ;;
    * ) ;;
esac

echo
echo "#####################"
echo "#  Konec instalace  #"
echo "#####################"
echo
echo "####################################"
echo "#  Restartovat do nového systému?  #"
echo "####################################"
while true; do
    read -r -n 1 -p "Vyberte (A/N): " answer
    case $answer in
        [Aa]* ) echo -e "\n Restartuji..."
                sleep 1
                sudo reboot; break;;
        [Nn]* ) exit;;
        * ) echo -e "\nVyberte A nebo N.";;
    esac
done

###  END OF FILE  ###
