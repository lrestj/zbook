#!/bin/bash

echo
echo " ##############################"
echo " #                            #"
echo " #  HOLA, VYBER SEZENÍ:       #"
echo " #                            #"
echo " #  s) SPUSTIT DEBIAN         #"
echo " #  r) RESTARTOVAT            #"
echo " #  x) VYPNOUT                #"
echo " #                            #"
echo " ##############################"
while true; do
  read -n 1 -s wm_choice
    case $wm_choice in
    "")
    echo
    echo "Spouštím Debian..."
    exec sway-run
    break;;
    s)
    echo
    echo "Spouštím Debian..."
    exec sway-run
    break;;
    [xv])
    echo "Vypínání..."
    exec systemctl poweroff
    sleep 1
    break;;
    r)
    echo "Restart..."
    sleep 1
    exec systemctl reboot
    break;;
    *)
    echo "Zvolte jednu z možností"
    ;;
    esac
done
