configuration {
    font: "jetBrains mono 13";
    auto-select: true;
    matching: "prefix";
    tokenize: false;
    sorting-method: "fzf";
    case-sensitive: false;
    show-icons: false;
    dmenu {
        exit-if-empty: false;
    }
}

* {
    foreground:                  rgba ( 180, 180, 180, 100 % );
    background:                  rgba ( 46, 52, 64, 96 % );
    border-color:                 rgba ( 128, 0, 255, 100 % );
}

window {
    height: 60px;
    width: 350px;
    border:           3;
    padding:          8;
}
listview {
    border:       0px dash 0px 0px ;
    scrollbar:    false;
}
inputbar {
    spacing:    0;
    padding:    1px ;
}
entry {
    placeholder: "";
}
inputbar {
    children:   [ prompt,textbox-prompt-colon,entry ];
}
