#!/bin/bash

a="Zamknout"
b="Odhlásit"
c="Restart"
d="Vypnout"
ai="\0icon\x1fsystem-lock-screen"
bi="\0icon\x1fsystem-log-out"
ci="\0icon\x1fsystem-reboot"
di="\0icon\x1fsystem-shutdown"

selected=$(echo -e "$b$bi\n$a$ai\n$c$ci\n$d$di" | rofi -i -config ~/.config/rofi/power.rasi -dmenu -theme-str 'inputbar { enabled: false; }' )
case $selected in
    "$a")
        lockscreen;;
    "$b")
        sleep 0.5; nfsumount && niri msg action quit --skip-confirmation;;
    "$c")
        sleep 0.5; nfsumount && loginctl reboot;;
    "$d")
        sleep 0.5; nfsumount && loginctl poweroff;;
esac
