#!/bin/bash

sel=$(fuzzel -d --prompt-only 'Jméno souboru:  ')
file=~/.local/bin/$sel

case $sel in
    "")
        notify-send "⚠️" "Přerušeno uživatelem"
    ;;
    *)
        touch $file
        chmod +x $file
        echo "#!/bin/bash" > $file
        $TERMINAL -e vim $file
    ;;
esac

#### END OF FILE ####
