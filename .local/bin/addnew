#!/bin/bash

sel=$(rofi -dmenu -config ~/.config/rofi/dmenu.rasi -lines 0 -height 50 -p "Jméno souboru" < /dev/null)
file=~/.local/bin/$sel

case $sel in
    "")
        notify-send -i im-kick-user -t 1000 "Nezadali jste jméno" "Konec bez vytvoření souboru"
    ;;
    *)
        touch $file
        chmod +x $file
        echo "#!/bin/bash" > $file
        $TERMINAL -e vim $file
    ;;
esac

#### END OF FILE ####
