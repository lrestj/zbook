#!/bin/bash

cat << "EOF"
#############################
#                           #
#    HOLA, VYBER SEZENÍ:    #
#                           #
#    Enter) SPUSTIT         #
#    R)     RESTARTOVAT     #
#    V)     VYPNOUT         #
#                           #
#############################
EOF

while true; do
    read -r -n 1 -s wm_choice
    case "$wm_choice" in
        ""|s|S)
            exec dbus-run-session /usr/bin/niri --session
            ;;
        r|R)
            echo "Restartování..."
            sleep 1
            exec loginctl reboot
            ;;
        v|V)
            echo "Vypínání..."
            sleep 1
            exec loginctl poweroff
            ;;
        *)
            echo "Neplatná volba. Stiskněte Enter, R nebo V."
            ;;
    esac
done

#### END OF FILE ####
