#!/bin/bash

a=" Vimrc"
b="Sway conf"
c="Waybar config"
d="Mako config"
e="Waybar css"
f="Stuff2remember"
g="Configuration.nix"
h="Flake.nix"
i="Pkgs"
j="Add new script"
k="Keybindings"
l="Windowsrules"
ai="\0icon\x1fvim"
bi="\0icon\x1fsweethome3d"
ci="\0icon\x1fwayland"
di="\0icon\x1fnotion"
ei="\0icon\x1fwayland"
fi="\0icon\x1fnotepad"
gi="\0icon\x1fpreferences-system-services"
hi="\0icon\x1fpreferences-system-services"
ii="\0icon\x1fpreferences-system-services"
ji="\0icon\x1fadd"
ki="\0icon\x1fsweethome3d"
li="\0icon\x1fsweethome3d"

selected=$(echo -e "\
$b$bi\n\
$k$ki\n\
$l$li\n\
$a$ai\n\
$c$ci\n\
$e$ei\n\
$d$di\n\
$f$fi\n\
$j$ji\
" | fuzzel --lines 14 -d )

case $selected in
    "$a")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/vim/vimrc";;
    "$b")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/sway/config";;
    "$c")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/waybar/config.jsonc";;
    "$d")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/mako/config";;
    "$e")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/waybar/style.css";;
    "$f")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.dotfiles/other/stuff2remember.txt";;
    "$g")
        $TERMINAL -e vim ~/.dotfiles/nixos/hosts/zbook/configuration.nix;;
    "$h")
        $TERMINAL -e vim ~/.dotfiles/nixos/flake.nix;;
    "$i")
        $TERMINAL -e vim ~/.dotfiles/nixos/modules/pkgs.nix;;
    "$j")
        addnew;;
    "$k")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/sway/keybindings";;
    "$l")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/sway/windowsrules";;

esac

