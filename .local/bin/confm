#!/bin/bash

a=" Vimrc"
b="Sway conf"
c="Waybar config"
d="Tiskárna web"
e="Waybar css"
f="Stuff2remember"
g="Configuration.nix"
h="Flake.nix"
i="Pkgs"
j="Add new script"
k="Keybindings"
l="Windowsrules"
m="Odpojit USB..."
n="GParted"
z="Upravit menu..."
ai="\0icon\x1fvim"
bi="\0icon\x1fsweethome3d"
ci="\0icon\x1fwayland"
di="\0icon\x1fprinter"
ei="\0icon\x1fwayland"
fi="\0icon\x1fnotepad"
gi="\0icon\x1fpreferences-system-services"
hi="\0icon\x1fpreferences-system-services"
ii="\0icon\x1fpreferences-system-services"
ji="\0icon\x1fadd"
ki="\0icon\x1fsweethome3d"
li="\0icon\x1fsweethome3d"
mi="\0icon\x1fudiskie-unmount"
ni="\0icon\x1fgparted"
zi="\0icon\x1fedile"

selected=$(echo -e "\
$b$bi\n\
$k$ki\n\
$l$li\n\
$a$ai\n\
$n$ni\n\
$c$ci\n\
$e$ei\n\
$d$di\n\
$f$fi\n\
$j$ji\n\
$m$mi\n\
$z$zi\
" | rofi -dmenu -i -show-icons -auto-select -p "Vyber" )

case $selected in
    "$a")
        $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim ~/.config/vim/vimrc";;
    "$b")
        $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim ~/.config/sway/config";;
    "$c")
        $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim ~/.config/waybar/config.jsonc";;
    "$d")
        $BROWSER http://192.168.77.5;;
    "$e")
        $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim ~/.config/waybar/style.css";;
    "$f")
        $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim ~/.dotfiles/install/stuff2remember.txt";;
    "$g")
        $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim ~/.dotfiles/nixos/hosts/zbook/configuration.nix";;
    "$h")
        $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim ~/.dotfiles/nixos/flake.nix";;
    "$i")
        $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim ~/.dotfiles/nixos/modules/pkgs.nix";;
    "$j")
        addnew;;
    "$m")
        rofi-umount;;
    "$n")
        $TERMINAL -e gp;;
    "$k")
        $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim ~/.config/sway/keybindings";;
    "$l")
        $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim ~/.config/sway/windowsrules";;
    "$z")
        $TERMINAL --class vim -e bash -c "sleep 0.1; exec vim ~/.local/bin/confm";;

esac

#### END OF FILE ####
