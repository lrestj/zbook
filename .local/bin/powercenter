#!/bin/bash

a="Zamknout"
b="Odhlásit"
c="Restart"
d="Vypnout"
ai="\0icon\x1fsystem-lock-screen"
bi="\0icon\x1fsystem-log-out"
ci="\0icon\x1fsystem-reboot"
di="\0icon\x1fsystem-shutdown"

selected=$(echo -e "$b$bi\n$a$ai\n$c$ci\n$d$di" | rofi -dmenu -config ~/.config/rofi/menu.rasi -theme-str 'inputbar { enabled: false; }' -i -show-icons)
case $selected in
    "$a")
        lockscreen;;
    "$b")
        sleep 1; swaymsg exit;;
    "$c")
        sleep 1; systemctl reboot;;
    "$d")
        sleep 1; systemctl poweroff;;
esac
