#!/bin/bash

sel=$(echo -n "" | rofi -dmenu -p "Jméno souboru")
file=~/.local/bin/$sel

case $sel in
    "")
        notify-send -i im-kick-user -t 1000 "Nezadali jste jméno" "Konec bez vytvoření souboru"
    ;;
    *)
        touch $file
        chmod +x $file
        echo "#!/bin/bash" > $file
        $TERMINAL -e vim $file
    ;;
esac
