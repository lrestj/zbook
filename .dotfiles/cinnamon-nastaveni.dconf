[/]
desktop-effects=false
desktop-effects-on-dialogs=false
desktop-effects-on-menus=false
desktop-effects-workspace=false
enable-vfade=false
enabled-applets=['panel1:left:0:menu@cinnamon.org:0', 'panel1:left:2:separator@cinnamon.org:1', 'panel1:left:3:grouped-window-list@cinnamon.org:2', 'panel1:right:7:systray@cinnamon.org:3', 'panel1:right:8:xapp-status@cinnamon.org:4', 'panel1:right:9:notifications@cinnamon.org:5', 'panel1:right:11:removable-drives@cinnamon.org:7', 'panel1:right:12:keyboard@cinnamon.org:8', 'panel1:right:13:favorites@cinnamon.org:9', 'panel1:right:14:network@cinnamon.org:10', 'panel1:right:15:sound@cinnamon.org:11', 'panel1:right:16:power@cinnamon.org:12', 'panel1:right:17:calendar@cinnamon.org:13', 'panel1:right:18:cornerbar@cinnamon.org:14', 'panel1:left:1:workspace-switcher@cinnamon.org:16', 'panel1:right:0:color-picker@fmete:21']
next-applet-id=22
panel-edit-mode=false
panel-zone-symbolic-icon-sizes='[{"panelId": 1, "left": 28, "center": 28, "right": 16}]'
panels-autohide=['1:intel']
panels-enabled=['1:0:top']
panels-height=['1:40']
startup-animation=false
window-effect-speed=1

[cinnamon-session]
quit-time-delay=60

[desktop/applications/calculator]
exec='gnome-calculator'

[desktop/applications/terminal]
exec='alacritty'
exec-arg='--'

[desktop/background]
picture-options='zoom'
picture-uri='file:///home/libor/.dotfiles/wallpapers/Purple%20Debian.jpg'

[desktop/background/slideshow]
delay=15
image-source='xml:///usr/share/gnome-background-properties/debian-joy.xml'

[desktop/input-sources]
sources=[('xkb', 'cz+bksl')]
xkb-options=['terminate:ctrl_alt_bksp', 'caps:swapescape']

[desktop/interface]
cursor-blink-time=1318
cursor-size=30
cursor-theme='Bibata-Modern-Classic'
font-name='Sans 11'
gtk-theme='Mint-Y-Dark'
icon-theme='Mint-Y-Purple'
text-scaling-factor=1.0

[desktop/keybindings]
custom-list=['custom1', 'custom2', 'custom0', 'custom3', 'custom4', 'custom5', 'custom6', 'custom7', 'custom8', 'custom9', '__dummy__']
show-desklets=@as []

[desktop/keybindings/custom-keybindings/custom0]
binding=['<Super>u']
command='gnome-terminal -e /home/libor/.local/bin/vimbuild'
name='Vim update'

[desktop/keybindings/custom-keybindings/custom1]
binding=['<Super>s']
command='/bin/nemo'
name='Nemo'

[desktop/keybindings/custom-keybindings/custom2]
binding=['<Alt>y']
command='kitty -e /usr/bin/yazi'
name='Yazi'

[desktop/keybindings/custom-keybindings/custom3]
binding=['<Super>e']
command='alacritty --class vim -e vim'
name='Vim'

[desktop/keybindings/custom-keybindings/custom4]
binding=['<Super>x']
command='cinnamon-session-quit --power-off'
name='Vypnout'

[desktop/keybindings/custom-keybindings/custom5]
binding=['<Alt>b']
command='alacritty --class btop -e btop'
name='Btop'

[desktop/keybindings/custom-keybindings/custom6]
binding=['<Super>m']
command='rofilinks'
name='Rofi links'

[desktop/keybindings/custom-keybindings/custom7]
binding=['<Super>g']
command='brave-browser https://www.gmail.com &'
name='Gmail'

[desktop/keybindings/custom-keybindings/custom8]
binding=['<Super>c']
command='centerwin'
name='CenterWin'

[desktop/keybindings/custom-keybindings/custom9]
binding=['<Super>y']
command='alacritty --class yazi -e yazi'
name='YaziAl'

[desktop/keybindings/media-keys]
calculator=['XF86Calculator', '<Super>k']
home=['XF86Explorer']
logout=['<Control><Alt>Delete', '<Super>backslash']
shutdown=['<Control><Alt>End', 'XF86PowerOff']
terminal=['<Super>a']
www=['<Super>b']

[desktop/keybindings/wm]
close=['<Super>q']
maximize=@as []
move-to-center=['<Super>KP_0']
move-to-workspace-left=['<Alt><Super>Left']
move-to-workspace-right=['<Alt><Super>Right']
switch-to-workspace-left=['<Alt>Left']
switch-to-workspace-right=['<Alt>Right']
toggle-maximized=['<Alt>F10', '<Super>f']

[desktop/media-handling]
autorun-never=false
autorun-x-content-ignore=['x-content/unix-software']
autorun-x-content-open-folder=@as []
autorun-x-content-start-app=@as []

[desktop/peripherals/keyboard]
delay=uint32 500
numlock-state=true
repeat-interval=uint32 30

[desktop/peripherals/mouse]
double-click=400
drag-threshold=8
natural-scroll=true
speed=0.0

[desktop/peripherals/touchpad]
natural-scroll=false
speed=0.26593406593406588

[desktop/sound]
event-sounds=false

[desktop/wm/preferences]
num-workspaces=3
titlebar-font='Sans Bold 11'
workspace-names=@as []

[gestures]
pinch-percent-threshold=uint32 40
swipe-down-2='PUSH_TILE_DOWN::end'
swipe-down-3='TOGGLE_OVERVIEW::end'
swipe-down-4='VOLUME_DOWN::end'
swipe-left-2='PUSH_TILE_LEFT::end'
swipe-left-3='WORKSPACE_NEXT::end'
swipe-left-4='WINDOW_WORKSPACE_PREVIOUS::end'
swipe-percent-threshold=uint32 60
swipe-right-2='PUSH_TILE_RIGHT::end'
swipe-right-3='WORKSPACE_PREVIOUS::end'
swipe-right-4='WINDOW_WORKSPACE_NEXT::end'
swipe-up-2='PUSH_TILE_UP::end'
swipe-up-3='TOGGLE_EXPO::end'
swipe-up-4='VOLUME_UP::end'
tap-3='MEDIA_PLAY_PAUSE::end'

[launcher]
check-frequency=300
memory-limit=2048

[settings-daemon/peripherals/keyboard]
numlock-state='on'

[settings-daemon/plugins/color]
night-light-last-coordinates=(50.049999999999997, 14.26)

[settings-daemon/plugins/power]
button-power='interactive'
lid-close-ac-action='nothing'
lid-close-battery-action='nothing'
sleep-display-ac=1800
sleep-display-battery=1800
sleep-inactive-ac-timeout=0
sleep-inactive-battery-timeout=0

[theme]
name='Mint-Y-Dark'
