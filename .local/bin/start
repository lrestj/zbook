#!/bin/bash

echo "#############################"
echo "#                           #"
echo "#    HOLA, VYBER SEZENÍ:    #"
echo "#                           #"
echo "#  Enter) SPUSTIT           #"
echo "#      R) RESTARTOVAT       #"
echo "#      V) VYPNOUT           #"
echo "#                           #"
echo "#############################"

while true; do
read -n 1 -s wm_choice
    case $wm_choice in
    s)
    exec dbus-run-session /usr/bin/niri --session
    break;;
    "")
    exec dbus-run-session /usr/bin/niri --session
    break;;
    x)
    echo "Vypínání..."
    sleep 1
    exec loginctl poweroff
    break;;
    r)
    echo "Restart..."
    sleep 1
    exec loginctl reboot
    break;;
    *)
    echo "Vyberte jednu z možností";;
    esac
done
