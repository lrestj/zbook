#!/bin/bash

echo
echo " ##############################"
echo " #                            #"
echo " #  HOLA, VYBER SEZENÍ:       #"
echo " #                            #"
echo " #  enter) SPUSTIT            #"
echo " #  n) NIRI                   #"
echo " #  r) RESTARTOVAT            #"
echo " #  x) VYPNOUT                #"
echo " #                            #"
echo " ##############################"
while true; do
  read -n 1 -s wm_choice
    case $wm_choice in
    "")
    echo
    echo "Spouštím Nixos..."
    exec niri --session
    ;;
    n)
    echo
    echo "Spouštím Nixos..."
    exec niri --session
    ;;
    [xv])
    echo "Vypínání..."
    exec systemctl poweroff
    sleep 1
    ;;
    r)
    echo "Restart..."
    sleep 1
    exec systemctl reboot
    ;;
    *)
    echo "Zvolte jednu z možností"
    ;;
    esac
done

#### END OF FILE ####
