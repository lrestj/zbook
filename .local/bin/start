#!/bin/bash

echo
echo " ##############################"
echo " #                            #"
echo " #        HOLA, VYBER:        #"
echo " #                            #"
echo " #    Enter) SPUSTIT          #"
echo " #        R) RESTARTOVAT      #"
echo " #        V) VYPNOUT          #"
echo " #                            #"
echo " ##############################"

while true; do
    read -n 1 -s -r wm_choice
    case "$wm_choice" in
        "")
            echo
            echo "Spouštím NixOS..."
            exec niri --session
            ;;
        [vVxX])
            echo "Vypínání..."
            sleep 1
            exec systemctl poweroff
            ;;
        [rR])
            echo "Restart..."
            sleep 1
            exec systemctl reboot
            ;;
        *)
            echo "Zvolte jednu z možností"
            ;;
    esac
done

#### END OF FILE ####
