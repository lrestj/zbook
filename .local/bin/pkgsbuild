#!/bin/bash

echo
echo "######################"
echo "#  Instalace vim     #"
echo "######################"
mkdir -p $HOME/.local/src
cd $HOME/.local/src
git clone --depth=222 https://github.com/vim/vim.git
cd vim/src
make
sudo make install

echo
echo "###########################"
echo "#  Instalace xfce-polkit  #"
echo "###########################"
echo
sudo apt -y install ninja-build libxfce4ui-2-dev libpolkit-agent-1-dev
mkdir -p $HOME/.local/src/
cd $HOME/.local/src
git clone https://github.com/ncopa/xfce-polkit.git
cd xfce-polkit
mkdir -p build
cd build
meson setup --prefix=/usr ..
ninja
sudo ninja install

#### END OF FILE ####
