// -*- mode: jsonc -*-

// WAYBAR AT THE TOP

[{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 39, // Waybar height (to be removed for auto height)
    "autohide": true,
    "autohide-blocked": false,
    "margin-top": 3,
    "margin-left": 8,
    "margin-right": 8,
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    "modules-left": [
        "sway/workspaces",
        "sway/scratchpad",
        "memory",
        "cpu",
        "temperature",
        "custom/scan",
        "custom/office",
        "custom/kalk",
        "custom/text",
        "custom/fm",
        "custom/browser"
    ],
    "modules-center": [
        "sway/window",
        "wlr/taskbar"
    ],
    "modules-right": [
        "idle_inhibitor",
        "tray",
        "mpd",
        "pulseaudio",
        "backlight",
        "clock",
        "battery",
        "power-profiles-daemon",
        "custom/power"
    ],

    "sway/workspaces": {
        "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": []
        },
        "format": "{value}",
        "format-icons": {
            "default": "",
            "active": ""
        }
    },

    "sway/scratchpad": {
        "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": []
        },
        "format": "{icon} {count}",
        "show-empty": false,
        "tooltip": true,
        "tooltip-format": "{app}: {title}",
        "format-icons": {
            "empty": "",
            "default": ""
        }
    },

    "memory": {
        "format": " Menu  RAM   {}% ",
        "on-click": "pkill $MENU || rofi -show drun"
    },

    "cpu": {
        "format": "CPU   {usage}%",
        "tooltip": false,
        "on-click": "pkill $TERMINAL || $TERMINAL",
        "on-click-right": "",
        "on-click-middle": ""
    },

    "temperature": {
        "thermal-zone": 0,
        "critical-threshold": 80,
        "format": " {icon} {temperatureC} °C  ",
        "format-icons": ["", "", ""],
        "on-click": "pkill btop || $TERMINAL --app-id btop -e btop",
        "on-click-right": ""
    },

   "custom/scan": {
        "format":"       ",
        "tooltip-format": "Skener",
        "on-click": "pkill simple-scan || simple-scan"
    },

    "custom/office": {
        "format":"       ",
        "tooltip-format": "LibreOffice",
        "on-click": "libreoffice",
        "on-click-right": "libreoffice --writer"
    },

    "custom/kalk": {
        "format":"       ",
        "tooltip-format": "Kalkulačka",
        "on-click": "pkill $KALK || $KALK"
    },

    "custom/text": {
        "format":"     ",
        "tooltip-format": "Textový editor",
        "on-click": "pkill geany || geany"
    },

   "custom/fm": {
        "format":"        ",
        "tooltip-format": "Soubory",
        "on-click": "pkill $FILEMGR || $FILEMGR"
    },

   "custom/browser": {
        "format":"      ",
        "tooltip-format": "Internet",
        "on-click":"$BROWSER"
   },

   "sway/window": {
        "format": "{}",
        "max-length": 40,
        "icon": false,
        "icon-size": 16
    },

   "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 25,
        "tooltip": true,
        "tooltip-format": "{app_id}",
        "on-click": "activate",
        "on-click-right": "close"
   },

   "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "  ",
            "deactivated": "  "
        },
        "on-click-right": "waybar --config ~/.config/waybar/config-taskbar"
   },

   "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "󰕾 {volume}%  {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pkill pavucontrol || pavucontrol"
   },

   "backlight": {
        // "device": "acpi_video1",
        "format": " 󰃟  {percent}%  ",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-click-right": "pkill foot || foot",
        "on-click": "pkill btop || foot -T btop -e btop"
   },

   "tray": {
        // "icon-size": 21,
        "spacing": 10
   },

   "clock": {
        "timezone": "Europe/Prague",
        "locale": "cs_CZ.UTF-8",
        "format": "  {:%H:%M }",
        "tooltip-format": "<big>{:L%e L%B %Y }</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:L%A %d.%m.%Y}"
   },

   "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon} ",
        "format-full": "{capacity}% {icon} ",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
   },

   "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "  ",
            "performance": "  ",
            "balanced": " ",
            "power-saver": " "
        }
   },
   "custom/power": {
        "format" : "  ",
        "tooltip-format": "",
        "on-click": "pkill rofi || power"
   }
}] 


